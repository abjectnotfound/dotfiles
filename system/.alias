# Shortcuts

alias reload="source ~/.bash_profile"
alias _="sudo"
alias g="git"
alias rr="rm -rf"

# Default options

alias rsync="rsync -vh"
alias json="json -c"
alias psgrep="psgrep -i"

# List declared aliases, functions, paths

alias aliases="alias | sed 's/=.*//'"
alias functions="declare -f | grep '^[a-z].* ()' | sed 's/{$//'"
alias paths='echo -e ${PATH//:/\\n}'

# Directory listing/traversal

# GNU ls supports all three flags; BSD ls only has -G for color

if command ls --version >/dev/null 2>&1; then
  LS_COLORIZED=--color
  LS_TIMESTYLEISO=--time-style=long-iso
  LS_GROUPDIRSFIRST=--group-directories-first
else
  LS_COLORIZED=-G
  LS_TIMESTYLEISO=
  LS_GROUPDIRSFIRST=
fi

alias l="ls -lahA $LS_COLORIZED $LS_TIMESTYLEISO $LS_GROUPDIRSFIRST"
alias ll="ls -lA $LS_COLORIZED"
alias lt="ls -lhAtr $LS_COLORIZED $LS_TIMESTYLEISO $LS_GROUPDIRSFIRST"
alias ld="ls -ld $LS_COLORIZED */"
alias lp="stat -c '%a %n' *"

unset LS_COLORIZED LS_TIMESTYLEISO LS_GROUPDIRSFIRST

# eza (modern ls)

if command -v eza >/dev/null; then
  alias l='eza -lh --icons=auto'
  alias ls='eza -1 --icons=auto'
  alias ll='eza -lha --icons=auto --sort=name --group-directories-first'
  alias ld='eza -lhD --icons=auto'
  alias lt='eza --icons=auto --tree'
fi

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'
alias -- -="cd -"                  # Go to previous dir with -
alias cd.='cd $(readlink -f .)'    # Go to real dir (i.e. if current dir is linked)

# p/npm

alias b="bun"
alias p="pnpm"
alias ncu="npm-check-updates --interactive"
alias ncuw="npm-check-updates --interactive --root --workspaces"

# Network

alias ipp="dig -4 +short myip.opendns.com @resolver1.opendns.com"
alias ipp6="dig -6 +short AAAA myip.opendns.com @resolver1.opendns.com"
alias ipl="ip route get 1.1.1.1 2>/dev/null | awk 'NR==1{print \$7}'"

# Miscellaneous

alias hosts="sudo $EDITOR /etc/hosts"
alias quit="exit"
alias week="date +%V"
alias speedtest="wget -O /dev/null http://speed.transip.nl/100mb.bin"
alias grip="grip --browser --pass=$GITHUB_TOKEN"
alias fkill="ps -e | fzf | awk '{print \$1}' | xargs kill"
alias df='df -Tha --total'
alias du='du -ach | sort -h'
alias psa='ps -auxf'
alias mkdir='mkdir -pv'
alias wget='wget -c'
alias myip='curl http://ipecho.net/plain; echo'
alias c='clear'
alias vc='code'
alias inv='nvim $(fzf -m --preview="bat --color=always {}")'
alias svi='sudo nvim'
alias kssh='kitten ssh'
alias tg='topgrade'
alias docker-clean='docker container prune -f && docker image prune -f && docker network prune -f && docker volume prune -f'

