export EDITOR="nvim"
export VISUAL="nvim"
export VISUAL_GIT="lazygit -p"

# Some app locations

export CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
export CHROME_CANARY_BIN="/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary"
export FIREFOX_BIN="/Applications/Firefox.app/Contents/MacOS/firefox-bin"

# Raise limit for open files and processes

ulimit -S -n 8192

# Load SSH keys whose passphrases are stored in the keychain (`ssh-add --apple-use-keychain <key>`).
# git signs with ssh-keygen, which only avoids prompting when the key is already in the agent.

ssh-add --apple-load-keychain -q 2>/dev/null
