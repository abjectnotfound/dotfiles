{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": [
        "mgrep",
        "mcp"
      ],
      "enabled": true
    }
  }
}