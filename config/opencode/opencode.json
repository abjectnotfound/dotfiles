{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.6-pro",
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  }
}
